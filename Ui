function Section:AddToggle(o)
	local state = o.Default == true
	local f = card(self.Frame, o.Desc and 46 or 36)
	label(f, o.Name, { Box = UDim2.new(1, -62, 0, 18), Pos = UDim2.fromOffset(12, o.Desc and 6 or 9) })
	if o.Desc then label(f, o.Desc, { Box = UDim2.new(1, -62, 0, 14), Pos = UDim2.fromOffset(12, 25), Size = 11, Role = "SubText" }) end
	local track = make("Frame", { Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -48, 0.5, -9), BorderSizePixel = 0, Parent = f })
	pill(track)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0, BackgroundColor3 = c(245, 245, 250),
		Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2), Parent = track,
	})
	pill(knob)
	local function paint(t) tween(track, { BackgroundColor3 = state and C("Accent") or C("Stroke") }, t) end
	reg(paint)

	local obj = {}
	function obj.Set(v, silent)
		state = v and true or false
		paint()
		tween(knob, { Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) }, BACK)
		if not silent and o.Callback then task.spawn(o.Callback, state) end
	end
	function obj.Get() return state end

	local hit = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = f })
	hover(hit, f)
	hit.MouseButton1Click:Connect(function() obj.Set(not state) end)
	return obj
end

function Section:AddSlider(o)
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local value = math.clamp(o.Default or min, min, max)
	local f = card(self.Frame, 52)
	label(f, o.Name, { Box = UDim2.new(1, -90, 0, 22), Pos = UDim2.fromOffset(12, 5) })
	local val = label(f, "", { Box = UDim2.fromOffset(70, 22), Pos = UDim2.new(1, -82, 0, 5), AlignX = Enum.TextXAlignment.Right, Role = "SubText", Size = 12 })
	local track = make("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 36), BorderSizePixel = 0, Parent = f })
	pill(track)
	bind(track, "BackgroundColor3", "Stroke")
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track })
	pill(fill)
	bind(fill, "BackgroundColor3", "Accent")
	local knob = make("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BorderSizePixel = 0, ZIndex = 2, Parent = fill })
	pill(knob)
	bind(knob, "BackgroundColor3", "Text")
	local knobScale = make("UIScale", { Parent = knob })

	local obj = {}
	local function render()
		fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
		val.Text = string.format("%g", value) .. (o.Suffix or "")
	end
	function obj.Set(v, silent)
		v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
		value = tonumber(string.format("%.4f", v))
		render()
		if not silent and o.Callback then o.Callback(value) end
	end
	function obj.Get() return value end
	render()

	local dragging = false
	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		obj.Set(min + (max - min) * a)
	end
	local hit = make("TextButton", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 18), BackgroundTransparency = 1, Text = "", Parent = f })
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging = true
			lockScroll(f, true)
			tween(knobScale, { Scale = 1.5 }, BACK)
			fromX(i.Position.X)
		end
	end)
	connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
	end)
	connect(UserInputService.InputEnded, function(i)
		if isPress(i) and dragging then
			dragging = false
			lockScroll(f, false)
			tween(knobScale, { Scale = 1 }, BACK)
		end
	end)
	return obj
end

function Section:AddDropdown(o)
	local options = o.Options
	local current = o.Default or options[1]
	local open = false
	local obj = {}

	local container = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(self.Frame), Parent = self.Frame })
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container })

	local head = card(container, 36)
	if o.Name then label(head, o.Name, { Box = UDim2.new(0.5, 0, 1, 0), Pos = UDim2.fromOffset(12, 0), Role = "SubText", Size = 12 }) end
	local valLabel = label(head, current, { Box = UDim2.new(1, -40, 1, 0), AlignX = Enum.TextXAlignment.Right, Role = "Accent", Size = 12 })
	local chev = label(head, ">", { Box = UDim2.fromOffset(20, 36), Pos = UDim2.new(1, -30, 0, 0), AlignX = Enum.TextXAlignment.Center, Font = BOLD, Role = "SubText", Size = 13 })
	chev.Rotation = 90
	local hit = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = head })
	hover(hit, head)

	local searchable = o.Search == true
	local listH = math.min(#options * 26 + 4, 132)
	local top = searchable and 40 or 6
	local fullH = top + listH + 6
	local panel = make("Frame", { Size = UDim2.new(1, 0, 0, fullH), Visible = false, BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = 2, Parent = container })
	bind(panel, "BackgroundColor3", "Surface")
	outline(panel)
	round(panel, 8)

	local box
	if searchable then
		box = make("TextBox", {
			Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 7), Text = "", PlaceholderText = "Search...",
			ClearTextOnFocus = false, Font = FONT, TextSize = 12, BorderSizePixel = 0, Parent = panel,
		})
		bind(box, "BackgroundColor3", "Background")
		bind(box, "TextColor3", "Text")
		bind(box, "PlaceholderColor3", "SubText")
		round(box, 6)
	end

	local list = make("ScrollingFrame", {
		Size = UDim2.new(1, -16, 0, listH), Position = UDim2.fromOffset(8, top), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
	})
	bind(list, "ScrollBarImageColor3", "Accent")
	make("UIListLayout", { Padding = UDim.new(0, 2), Parent = list })

	local setOpen
	local function render()
		for _, ch in ipairs(list:GetChildren()) do
			if ch:IsA("TextButton") then ch:Destroy() end
		end
		local q = box and box.Text:lower() or ""
		for _, opt in ipairs(options) do
			if q == "" or opt:lower():find(q, 1, true) then
				local sel = opt == current
				local b = make("TextButton", {
					Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = opt, TextXAlignment = Enum.TextXAlignment.Left,
					Font = FONT, TextSize = 12, AutoButtonColor = false, TextColor3 = sel and C("Accent") or C("SubText"), Parent = list,
				}, { make("UIPadding", { PaddingLeft = UDim.new(0, 8) }) })
				b.MouseEnter:Connect(function() if opt ~= current then tween(b, { TextColor3 = C("Text") }) end end)
				b.MouseLeave:Connect(function() if opt ~= current then tween(b, { TextColor3 = C("SubText") }) end end)
				b.MouseButton1Click:Connect(function()
					obj.Set(opt)
					setOpen(false)
				end)
			end
		end
	end

	function setOpen(v)
		open = v
		tween(chev, { Rotation = v and -90 or 90 }, BACK)
		if v then
			render()
			panel.Visible = true
			panel.Size = UDim2.new(1, 0, 0, 0)
			tween(panel, { Size = UDim2.new(1, 0, 0, fullH) }, SLOW)
		else
			tween(panel, { Size = UDim2.new(1, 0, 0, 0) }, FAST)
			task.delay(0.16, function() if not open then panel.Visible = false end end)
		end
	end

	function obj.Set(v, silent)
		current = v
		valLabel.Text = v
		if open then render() end
		if not silent and o.Callback then task.spawn(o.Callback, v) end
	end
	function obj.Get() return current end

	if box then box:GetPropertyChangedSignal("Text"):Connect(render) end
	reg(function() if open then render() end end)
	hit.MouseButton1Click:Connect(function() setOpen(not open) end)
	return obj
end

function Section:AddColorPicker(o)
	local h, s, v = (o.Default or c(255, 255, 255)):ToHSV()
	local open = false
	local obj = {}

	local container = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(self.Frame), Parent = self.Frame })
