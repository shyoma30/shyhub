	----------------------------------------------------------------- tabs
	local tabs = {}
	function Window:AddTab(name)
		local tab = { selected = false }
		local btn = make("TextButton", { Size = UDim2.new(1, 0, 0, 36), Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = #tabs + 1, Parent = tabsFrame })
		round(btn, 8)
		local lbl = make("TextLabel", { Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, Text = name, Font = FONT, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn })
		local function paint(t)
			tween(btn, { BackgroundColor3 = tab.selected and C("Accent") or C("Element"), BackgroundTransparency = tab.selected and 0 or 0.45 }, t)
			tween(lbl, { TextColor3 = tab.selected and onAccent() or C("SubText") }, t)
		end
		reg(paint)
		tab.paint = paint

		local page = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false, Parent = pages,
		})
		bind(page, "ScrollBarImageColor3", "Accent")
		make("UIPadding", { PaddingRight = UDim.new(0, 8), Parent = page })
		local cols = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page })
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Top, Parent = cols })
		local function column()
			local col = make("Frame", { Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = cols })
			make("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
			return col
		end
		local left, right = column(), column()
		tab.page = page
		table.insert(tabs, tab)

		local function choose()
			for _, t in ipairs(tabs) do
				t.selected = false
				t.page.Visible = false
				t.paint(FAST)
			end
			tab.selected = true
			page.Position = UDim2.fromOffset(0, 18)
			page.Visible = true
			tween(page, { Position = UDim2.fromOffset(0, 0) }, SLOW)
			paint(FAST)
		end
		btn.MouseButton1Click:Connect(choose)
		btn.MouseEnter:Connect(function()
			if not tab.selected then
				tween(btn, { BackgroundTransparency = 0.15 })
				tween(lbl, { Position = UDim2.fromOffset(20, 0) })
			end
		end)
		btn.MouseLeave:Connect(function()
			if not tab.selected then tween(btn, { BackgroundTransparency = 0.45 }) end
			tween(lbl, { Position = UDim2.fromOffset(14, 0) })
		end)
		if #tabs == 1 then choose() end

		function tab:AddSection(title, side)
			local parent = (side == "Right") and right or left
			local frame = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(parent), Parent = parent })
			make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = frame })
