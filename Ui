-- one toggle in the UI + one on-screen button + one keybind row, kept in sync
local function feature(sec, name, desc, icon, apply)
	local h = { Def = { Name = name, Kind = "toggle" }, state = false, sync = {} }
	local tog, mob
	function h.Set(v, from)
		v = v and true or false
		h.state = v
		apply(v)
		if from ~= "ui" and tog then tog.Set(v, true) end
		if from ~= "mob" and mob then mob.Set(v, true) end
		for _, fn in ipairs(h.sync) do fn(v) end
	end
	tog = sec:AddToggle({ Name = name, Desc = desc, Callback = function(v) h.Set(v, "ui") end })
	mob = Window:AddMobileButton({ Name = name, Icon = icon, Callback = function(v) h.Set(v, "mob") end })
	Registry.add(h)
	table.insert(cleanups, function() apply(false) end)
	return h.Set
end

