	----------------------------------------------------------------- mobile shortcut buttons
	local mobileHolder = make("Frame", { Name = "MobileButtons", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 4, Parent = gui })

	local function placeMobile(btn, idx)
		local size = mobileSize
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 400)
		local gap = 8
		local perCol = math.max(1, math.floor((vp.Y - 80) / (size + gap)))
		local col, row = (idx - 1) // perCol, (idx - 1) % perCol
		btn.Size = UDim2.fromOffset(size, size)
		btn.Position = UDim2.new(1, -(size + 12) - col * (size + gap), 0, 56 + row * (size + gap))
	end

	function Window:AddMobileButton(o)
		local idx = #mobileList + 1
		local toggle = o.Toggle ~= false
		local state = false

		local btn = make("TextButton", {
			Name = "MB_" .. o.Name, Text = "", AutoButtonColor = false, BorderSizePixel = 0, Parent = mobileHolder,
		})
		placeMobile(btn, idx)
		round(btn, 14)
		local stroke = outline(btn, "Accent", 1.5)
		stroke.Transparency = 0.5
		local pop = make("UIScale", { Parent = btn })

		local icon
		if o.Icon and tostring(o.Icon):find("rbxassetid") then
			icon = make("ImageLabel", { Size = UDim2.fromScale(0.46, 0.46), Position = UDim2.fromScale(0.27, 0.12), BackgroundTransparency = 1, Image = o.Icon, Parent = btn })
			bind(icon, "ImageColor3", "Text")
		else
			icon = make("TextLabel", { Size = UDim2.fromScale(0.6, 0.5), Position = UDim2.fromScale(0.2, 0.1), BackgroundTransparency = 1, Text = o.Icon or string.sub(o.Name, 1, 1), Font = BOLD, TextScaled = true, Parent = btn })
			bind(icon, "TextColor3", "Text")
		end
		local nameLbl = make("TextLabel", { Size = UDim2.new(1, -6, 0.24, 0), Position = UDim2.new(0, 3, 0.68, 0), BackgroundTransparency = 1, Text = string.upper(o.Name), Font = BOLD, TextScaled = true, Parent = btn })
		make("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 6, Parent = nameLbl })

		local function paint(t)
			tween(btn, { BackgroundColor3 = state and C("Accent") or C("Surface"), BackgroundTransparency = state and 0.2 or 0.12 }, t)
			tween(nameLbl, { TextColor3 = state and onAccent() or C("SubText") }, t)
			tween(stroke, { Transparency = state and 0 or 0.5 }, t)
		end
		reg(paint)

		local obj = {}
		function obj.Set(v, silent)
			state = v and true or false
			paint()
			if not silent and o.Callback then task.spawn(o.Callback, state) end
		end
		function obj.Get() return state end

		local drag = makeDraggable(btn, btn)
		btn.MouseEnter:Connect(function() tween(pop, { Scale = 1.1 }, BACK) end)
		btn.MouseLeave:Connect(function() tween(pop, { Scale = 1 }, BACK) end)
		btn.InputBegan:Connect(function(i) if isPress(i) then tween(pop, { Scale = 0.9 }, FAST) end end)
		btn.InputEnded:Connect(function(i)
			if isPress(i) then tween(pop, { Scale = i.UserInputType == Enum.UserInputType.Touch and 1 or 1.1 }, BACK) end
		end)
		btn.Activated:Connect(function()
			if drag.moved() then return end
			if toggle then
				obj.Set(not state)
			else
				tween(btn, { BackgroundColor3 = C("Accent") })
				task.delay(0.15, function() if btn.Parent then paint() end end)
				if o.Callback then task.spawn(o.Callback) end
			end
		end)

		table.insert(mobileList, { btn = btn, pop = pop })
		if mobileOn then
			pop.Scale = 0
			tween(pop, { Scale = 1 }, BACK)
		end
		return obj
	end

