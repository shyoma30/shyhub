	local swatch = make("Frame", { Size = UDim2.fromOffset(26, 18), Position = UDim2.new(1, -38, 0.5, -9), BorderSizePixel = 0, BackgroundColor3 = Color3.fromHSV(h, s, v), Parent = head })
